 $ p.value          : num [1:3, 1:3] 1.00 8.47e-05 2.45e-09 8.47e-05 ...
 $ global_pvalue    : num 4.15e-09
 $ descriptive_stats:'data.frame':	3 obs. of  4 variables:
  ..$ group        : chr [1:3] "A" "B" "C"
  ..$ adjusted_mean: num [1:3] 8.52 9.67 10.34
  ..$ SE           : num [1:3] 0.181 0.181 0.181
  ..$ type         : chr [1:3] "adjusted_mean" "adjusted_mean" "adjusted_mean"
 $ method           : chr "ANCOVA post-hoc (tukey adjustment)"
 $ effects          :'data.frame':	2 obs. of  2 variables:
  ..$ term   : chr [1:2] "F" "cov"
  ..$ p.value: num [1:2] 4.15e-09 2.56e-24
 $ details          :List of 5
  ..$ pairwise_comparisons:'data.frame':	3 obs. of  6 variables:
  ..$ emm_result          :'emmGrid' object with variables:
    F = A, B, C
  ..$ pairs_result        :'emmGrid' object with variables:
    contrast = A - B, A - C, B - C
  ..$ note                : chr "Post-hoc comparisons performed on adjusted means. Covariates held at their mean values: cov = 4.98"
  ..$ adjusted_means      :'data.frame':	3 obs. of  5 variables:
--- $method: ANCOVA post-hoc (tukey adjustment) 
--- $global_pvalue: 4.14815914671471e-09 
--- $chosen_test:  
--- $effects:
  term      p.value
1    F 4.148159e-09
2  cov 2.564704e-24


